# Copier ce fichier en .env et remplacer les valeurs. Ne jamais versionner .env.
# Toutes les valeurs ci-dessous sont des valeurs de TEST.

# --- Base de données (docker-compose.yml) ---
MYSQL_DATABASE=banlieue_alerte
MYSQL_USER=banlieue
MYSQL_PASSWORD=change-me-dev
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3307
# Prisma (migrations) et application. L'utilisateur doit pouvoir créer la base fantôme
# des migrations : en développement, on utilise root.
DATABASE_URL=mysql://root:change-me-root@127.0.0.1:3307/banlieue_alerte

# --- Données de démonstration (prisma/seed.ts) ---
# Mot de passe commun des 4 comptes de test (habitant, délégué, agent, administrateur).
SEED_TEST_PASSWORD=change-me-test

# --- Notifications (src/lib/notifications) ---
# simulation (par défaut) : les envois sont journalisés, jamais envoyés.
# live : envoi réel, seulement après un test réel d'intégration (CDC §4.6).
NOTIFICATIONS_MODE=simulation

# --- Mode démonstration (Phase 6) : désactivé par défaut ---
DEMO_MODE=false

# --- Développement sur téléphone (docs/TEST_TELEPHONE.md) ---
# Noms d'hôte supplémentaires autorisés par le serveur de dev, séparés par des virgules.
# Exemple : 192.168.1.20,*.ts.net
DEV_ALLOWED_ORIGINS=

# --- Sécurité (src/lib/security) ---
# Sel des empreintes (IP pour la limitation de débit, appareil pour le vote). Valeur longue et aléatoire.
HASH_SALT=change-me-salt

# --- Photos (src/lib/photos) : dossier de stockage local, non versionné ---
UPLOAD_DIR=uploads

# --- URL publique de l'application (métadonnées, liens de partage) ---
APP_URL=http://localhost:3000

# Multiplicateur des limites de débit, réservé aux tests automatisés (Playwright). Laisser à 1.
RATE_LIMIT_FACTOR=1

# --- Indice de risque (src/jobs/risk-refresh.ts) ---
# Secret du planificateur pour POST /api/jobs/risk-refresh (en-tête Authorization: Bearer …).
# Vide : seul un administrateur connecté peut relancer le calcul. Valeur longue et aléatoire.
CRON_SECRET=

# --- Double authentification de l'administrateur (D-064) ---
# Clé de chiffrement des secrets TOTP en base (longue et aléatoire). La changer rend
# illisibles les secrets existants : les administrateurs devront se réenrôler.
TOTP_ENCRYPTION_KEY=change-me-totp-key-long-random
# Secret TOTP (base32) du compte administrateur de démonstration, pour les tests et la démo.
# Vide : l'administrateur de démonstration s'enrôle à sa première connexion.
SEED_TEST_TOTP_SECRET=
